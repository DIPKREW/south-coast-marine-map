{
  "name": "south-coast-marine-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A calm, editorial interactive map of marine protected areas along the South Coast Marine Recovery Project coastline.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data": "npm run data:sssi && npm run data:hona && npm run data:centres && npm run data:dwt && npm run data:water && npm run data:water-named && npm run data:alc && npm run data:alc-post1988 && npm run data:crome && npm run data:species && npm run data:marine && npm run data:ncerm && npm run data:catchment && npm run data:storm-overflows && npm run data:wfd && npm run data:seabed && npm run data:marine-species && npm run data:recreational && npm run data:licensing && npm run data:bathing && npm run data:coastline && npm run data:pinnable",
    "data:sssi": "node scripts/fetch-sssi.mjs",
    "data:hona": "node scripts/build-hona.mjs",
    "data:dwt": "node scripts/fetch-dwt.mjs",
    "data:centres": "node scripts/build-centres.mjs",
    "data:water": "node scripts/fetch-water.mjs",
    "data:water-named": "node scripts/fetch-named-water.mjs",
    "data:alc": "node scripts/fetch-alc.mjs",
    "data:alc-post1988": "node scripts/fetch-alc-post1988.mjs",
    "data:crome": "node scripts/build-crome.mjs",
    "data:species": "node scripts/build-species.mjs",
    "data:marine": "node scripts/fetch-marine.mjs",
    "data:ncerm": "node scripts/build-ncerm.mjs",
    "data:storm-overflows": "node scripts/fetch-storm-overflows.mjs",
    "data:bathing": "node scripts/fetch-bathing-waters.mjs",
    "data:coastline": "node scripts/fetch-coastline.mjs",
    "data:pinnable": "node scripts/build-pinnable-area.mjs",
    "data:catchment": "node scripts/build-catchment-boundary.mjs",
    "data:wfd": "node scripts/fetch-wfd-coastal.mjs",
    "data:seabed": "node scripts/fetch-seabed.mjs",
    "data:marine-species": "node scripts/build-marine-species.mjs",
    "data:recreational": "node scripts/fetch-vessel-density.mjs",
    "data:licensing": "node scripts/fetch-marine-licensing.mjs",
    "data:fisheries": "node scripts/fetch-fisheries.mjs",
    "data:sea-flood": "node scripts/fetch-sea-flood.mjs",
    "data:wrecks": "node scripts/fetch-wrecks.mjs",
    "data:compound": "node scripts/build-compound-pressure.mjs",
    "data:search": "node scripts/build-search-index.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^4.4.1"
  },
  "devDependencies": {
    "@turf/buffer": "^7.4.0",
    "mapshaper": "^0.7.33",
    "osmtogeojson": "^3.0.0-beta.5",
    "proj4": "^2.12.1",
    "vite": "^5.4.10"
  }
}
