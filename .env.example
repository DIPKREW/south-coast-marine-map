# The base map runs KEYLESS out of the box via OpenFreeMap — no value needed here.
#
# This file documents an optional alternative only. If you later switch the base
# tiles to a provider that needs a key (e.g. MapTiler), set it here as VITE_*,
# copy this file to `.env`, and read it via import.meta.env in src/map/mapStyle.js.
#
# VITE_MAPTILER_KEY=your_key_here
